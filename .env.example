# Copy to .env at the repo root (git ignores it). The API, migrations and scripts all read it.
# On Render these are set in the dashboard instead (see render.yaml). Placeholders (change-me) are refused.

# development | test | staging | production
#   staging/production enforce: no dev sign-in, long SECRET_KEY, COOKIE_SECURE=true, admin MFA,
#   and hide the X-User-Id RAG routes and the API docs. production also requires a WorkOS live key (sk_live_).
ENVIRONMENT=development
SECRET_KEY=change-me-to-64-random-characters

# Database: Postgres with pgvector. Either one URL (Supabase: SESSION pooler, port 5432, not 6543) ...
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ... or the parts (local shared infrastructure):
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# POSTGRES_DB=lexaior_rag
# POSTGRES_USER=lexaior
# POSTGRES_PASSWORD=change-me
# Every table (firm and RAG) lives in this schema; Supabase's Data API only exposes `public`.
DB_SCHEMA=lexaior

# Sign-in: workos (our own screens, WorkOS behind them) or dev (local passwords, offline work and tests)
AUTH_PROVIDER=workos
WORKOS_API_KEY=sk_test_...          # WorkOS staging key; sk_live_ only in production
WORKOS_CLIENT_ID=client_...
# Public origin of the website. In WorkOS -> Redirects set:
#   User invitation URL  = {APP_URL}/accept-invite
#   Password reset URL   = {APP_URL}/reset-password
APP_URL=http://127.0.0.1:4174
CORS_ORIGINS=["http://127.0.0.1:4174"]

ADMIN_REQUIRE_MFA=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# Hosted behind the Cloudflare Worker: trust its X-Forwarded-For and require its shared secret.
TRUST_PROXY_HEADERS=false
PROXY_SECRET=

# Files: S3-compatible storage. Browsers upload and download with presigned URLs.
# seaweedfs locally; s3 for any other S3 endpoint (the bucket needs CORS for PUT/GET from APP_URL).
STORAGE_PROVIDER=seaweedfs
STORAGE_ENDPOINT_URL=http://127.0.0.1:8333
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=rag-documents
STORAGE_REGION=us-east-1

# Valkey: upload/processing progress for the live status streams.
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6380
VALKEY_PASSWORD=change-me

# Kafka: the outbox publishes one {"unstructured_thread_id": X} message per stage topic;
# the consumers repository processes the files. Inside Compose: kafka:19092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093
KAFKA_TOPIC_UPLOADED=doc.uploaded
KAFKA_TOPIC_PARSED=doc.parsed
KAFKA_TOPIC_QUERY=query.requested
KAFKA_TOPIC_STANDARDIZATION=STNDZ_TOPIC
KAFKA_TOPIC_CSV_PARQUET=CSV_PARQUET_TOPIC
KAFKA_TOPIC_MARKDOWN=RAG_MARKDOWN_TOPIC
KAFKA_TOPIC_IMAGE=RAG_IMAGE_TOPIC
KAFKA_TOPIC_METACLASSIFIER=METACLASSIFIER_TOPIC
OUTBOX_ENABLED=true
OUTBOX_POLL_SECONDS=1

# Folder uploads (collections)
THREAD_MAX_FILES=100
THREAD_MAX_FILE_BYTES=52428800
PRESIGN_EXPIRY_SECONDS=900
UPLOAD_ABANDON_SECONDS=86400
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
STAGE_STUCK_SECONDS=900
STANDARDIZATION_STUCK_SECONDS=1800
# Per-document upload API (development only)
MAX_UPLOAD_BYTES=20971520

# Retrieval: BGE-M3 embeddings + BGE reranker, loaded lazily from a local Hugging Face cache.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_CACHE_DIR=../kafka/.cache/huggingface/hub
EMBEDDING_DEVICE=auto
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RETRIEVAL_CANDIDATES=50
RETRIEVAL_RRF_K=60
RETRIEVAL_WARMUP=false

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama
# Deferred until the core RAG pipeline works.
REFERENCE_EXTRACTION_ENABLED=false
