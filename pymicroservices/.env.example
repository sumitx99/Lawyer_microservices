# Local template: provide credentials for the shared development infrastructure.
# Host-run applications use loopback. Future Compose apps use the service names.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=lexaior_rag
POSTGRES_USER=lexaior
POSTGRES_PASSWORD=change-me
DB_DRIVER=asyncpg
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

VALKEY_HOST=127.0.0.1
VALKEY_PORT=6380
VALKEY_PASSWORD=change-me

KAFKA_PORT=9093
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093
# Inside Compose: kafka:19092
KAFKA_TOPIC_UPLOADED=doc.uploaded
KAFKA_TOPIC_PARSED=doc.parsed
KAFKA_TOPIC_QUERY=query.requested

STORAGE_PROVIDER=seaweedfs
STORAGE_PORT=8333
STORAGE_ENDPOINT_URL=http://127.0.0.1:8333
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=rag-documents
STORAGE_REGION=us-east-1

OLLAMA_PORT=11434
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama

# Deferred until the core RAG pipeline works.
REFERENCE_EXTRACTION_ENABLED=false

# Document upload/API settings
MAX_UPLOAD_BYTES=20971520
OUTBOX_ENABLED=true
OUTBOX_POLL_SECONDS=1

# Folder pipeline (design doc): presigned upload to SeaweedFS, one Kafka message per folder.
KAFKA_TOPIC_STANDARDIZATION=STNDZ_TOPIC
KAFKA_TOPIC_CSV_PARQUET=CSV_PARQUET_TOPIC
KAFKA_TOPIC_MARKDOWN=RAG_MARKDOWN_TOPIC
KAFKA_TOPIC_IMAGE=RAG_IMAGE_TOPIC
KAFKA_TOPIC_METACLASSIFIER=METACLASSIFIER_TOPIC
THREAD_MAX_FILES=100
THREAD_MAX_FILE_BYTES=52428800
PRESIGN_EXPIRY_SECONDS=900
UPLOAD_ABANDON_SECONDS=86400
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
STAGE_STUCK_SECONDS=900
STANDARDIZATION_STUCK_SECONDS=1800
